# --- Telegram user account (Telethon, READ-ONLY listener) ---
# Get these from https://my.telegram.org -> API development tools
TG_API_ID=
TG_API_HASH=
TG_PHONE=
# Optional: for headless/cron hosting. Generate with: python -m jobpilot.main --make-session-string
TG_SESSION_STRING=
# Channel(s) to watch, comma-separated: @username or numeric id (e.g. -1001234567890).
# Your Telegram account must have JOINED each one for new posts to arrive live.
TG_CHANNEL=

# --- Approval bot (python-telegram-bot), created via @BotFather ---
BOT_TOKEN=
# Only this chat id may use the bot. Message @userinfobot to get yours.
BOT_OWNER_CHAT_ID=

# --- LLM ---
# One provider or a fallback chain: openai (paid), groq, gemini (free tiers), anthropic (paid).
# A call that hits one provider's rate limit/quota/outage moves to the next; providers
# without a key are skipped. Empty = openai,groq,gemini.
LLM_PROVIDER=openai,groq,gemini
# https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Free key from https://console.groq.com/keys
GROQ_API_KEY=
# Free key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Only needed if anthropic is in LLM_PROVIDER
ANTHROPIC_API_KEY=
# Model overrides (empty = defaults: openai gpt-6-luna, groq openai/gpt-oss-120b,
# gemini gemini-3.5-flash-lite, anthropic claude-haiku-5-5). LLM_MODEL goes to the provider
# its name belongs to (gpt-* -> openai, gemini-* -> gemini, ...).
LLM_MODEL=
OPENAI_MODEL=
GROQ_MODEL=
GEMINI_MODEL=

# --- Gmail API (OAuth desktop app) ---
GMAIL_CREDENTIALS_PATH=credentials.json
GMAIL_TOKEN_PATH=token.json
